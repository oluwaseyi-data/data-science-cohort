        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "8\n"
          ]
        }
      ],
      "source": [
        "def add_and_print(a, b):\n",
        "    result = a + b\n",
        "    print(result)  # Shows the result but can't use it later\n",
        "\n",
        "add_and_print(5, 3)  # Prints: 8\n",
        "# But we can't save or use that 8 anywhere else"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 102,
      "id": "2cbfceae",
      "metadata": {
        "id": "2cbfceae",
