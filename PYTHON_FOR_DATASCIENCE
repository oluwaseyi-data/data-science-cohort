      "id": "3e325a05",
      "metadata": {
        "id": "3e325a05"
      },
      "source": [
        "append(): This is useful when you simply want to add an item to the list without worrying about its index position."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 51,
      "id": "66d32452",
