        }
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "The sum is: 8\n"
          ]
        }
      ],
      "source": [
        "def add_and_return(a, b):\n",
        "    result = (a + b)\n",
        "    return result\n",
        "#     return result  # Gives back the result to use elsewhere\n",
        "\n",
        "answer = add_and_return(5, 3)  # answer now holds 8\n",
        "print(\"The sum is: \" + str(answer))  # We can use it!       # We can do math with it!\n"
      ]
    },
