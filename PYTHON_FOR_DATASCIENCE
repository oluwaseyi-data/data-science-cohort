      "metadata": {
        "id": "238ee6e9"
      },
      "source": [
        "* Sum\n",
        "\n",
        "The sum() function returns the sum of all numerical elements in a list."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 72,
      "id": "be9f48c0",
      "metadata": {
        "id": "be9f48c0",
        "outputId": "15858272-792a-4661-b7a0-707085796bd4",
